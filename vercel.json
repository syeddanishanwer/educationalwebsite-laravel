{
    "version": 2,
    "outputDirectory": "public",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/build/$1",
            "continue": true
        },
        {
            "src": "/img/(.*)",
            "dest": "/img/$1",
            "continue": true
        },
        {
            "src": "/css/(.*)",
            "dest": "/css/$1",
            "continue": true
        },
        {
            "src": "/lib/(.*)",
            "dest": "/lib/$1",
            "continue": true
        },
        {
            "src": "/js/(.*)",
            "dest": "/js/$1",
            "continue": true
        },
        {
            "src": "/favicon.ico",
            "dest": "/favicon.ico",
            "continue": true
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}